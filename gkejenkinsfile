pipeline {
  agent any

  environment {
    PROJECT_ID = "project-addaa4da-17e4-4d6e-ab0"
    REGION     = "us-central1"
    REPO       = "java-repo"
    IMAGE_NAME = "demo-app"
    IMAGE      = "us-central1-docker.pkg.dev/$PROJECT_ID/$REPO/demo-app"
    CLUSTER    = "dev"
    ZONE       = "us-central1-a"
  }

  stages {

    // stage('Checkout Code') {
    //   steps {
    //     git 'https://github.com/your-org/java-gke-app.git'
    //   }
    // }

    stage('Maven Build') {
      steps {
        sh 'mvn clean package'
      }
    }

    stage('Authenticate to GCP') {
      steps {
        sh '''
          # Use the Compute Engine VM's attached Service Account
          gcloud config set project $PROJECT_ID

          # Verify the authenticated account
          gcloud auth list

          # Configure Docker for Artifact Registry
          gcloud auth configure-docker us-central1-docker.pkg.dev --quiet
        '''
      }
    }

    stage('Build Image') {
      steps {
        sh """
          docker build -t $IMAGE:$BUILD_NUMBER .
          docker push $IMAGE:$BUILD_NUMBER
        """
      }
    }

    stage('Deploy to GKE') {
      steps {
        sh """
          gcloud container clusters get-credentials $CLUSTER --zone $ZONE

          kubectl get deployment demo-app || kubectl apply -f kubernetes/Deployment.yaml

          kubectl set image deployment/demo-app \
            demo=$IMAGE:$BUILD_NUMBER

          kubectl rollout status deployment/demo-app
        """
      }
    }
  }

  post {
    success {
      echo "✅ Application deployed successfully to GKE"
    }
    failure {
      echo "❌ Deployment failed"
    }
  }
}
